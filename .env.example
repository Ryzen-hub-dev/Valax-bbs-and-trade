# ==============================================================================
# Valax Scrub BBS & Trade - Environment Configuration Template
# Target: https://bbs-and-trade.valaxscrub.shop
# ==============================================================================

# Database (Turso LibSQL Serverless Database)
TURSO_DATABASE_URL=libsql://valax-project-teegabriel.aws-us-west-2.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Discord OAuth Configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://bbs-and-trade.valaxscrub.shop/api/auth/callback/discord

# Application Base URL
NEXT_PUBLIC_APP_URL=https://bbs-and-trade.valaxscrub.shop

# PayPal REST API Integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox # 'sandbox' or 'live'

# Admin Roles (Comma-separated Discord User IDs)
ADMIN_DISCORD_IDS=123456789012345678,234567890123456789